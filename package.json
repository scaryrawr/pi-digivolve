{
  "name": "pi-digivolve",
  "version": "1.0.0",
  "description": "Pi extension that runs one final digivolution reflection pass to improve durable repo instructions and skills when useful.",
  "keywords": [
    "agents",
    "digivolution",
    "pi",
    "pi-package",
    "skills"
  ],
  "license": "MIT",
  "author": "Mike Wallio",
  "type": "module",
  "main": "extensions/digivolve.ts",
  "scripts": {
    "typecheck": "tsgo --noEmit",
    "lint": "oxlint extensions",
    "format": "oxfmt --write extensions package.json tsconfig.json .oxlintrc.json .oxfmtrc.json",
    "check": "npm run typecheck && npm run lint"
  },
  "dependencies": {
    "typebox": "^1.3.34"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "^0.86.1",
    "@earendil-works/pi-coding-agent": "^0.86.1",
    "@oxlint/plugins": "1.83.0",
    "@types/node": "^26.6.2",
    "@typescript/native-preview": "^7.0.0-dev.20260707.2",
    "oxfmt": "^0.68.0",
    "oxlint": "^1.83.0",
    "oxlint-tsgolint": "^7.0.2002",
    "vitest": "^5.0.1"
  },
  "peerDependencies": {
    "@earendil-works/pi-coding-agent": ">=0.84.0"
  },
  "pi": {
    "extensions": [
      "./extensions/digivolve.ts"
    ],
    "skills": [
      "./skills"
    ]
  }
}
